page {
  background: #f3ede3;
  color: #16302b;
}

.page-shell {
  padding: 112px 24rpx 48rpx;
}

.nav-back {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding-left: 8rpx;
}

.nav-back-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-back-text {
  font-size: 26rpx;
  color: #16302b;
}

.hero-card,
.panel {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(125, 92, 38, 0.08);
}

.hero-card {
  background: linear-gradient(135deg, rgba(23, 52, 45, 0.96) 0%, rgba(47, 107, 95, 0.94) 72%, rgba(199, 140, 59, 0.88) 100%);
  color: #f8f2e9;
}

.hero-title,
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}

.hero-title {
  font-size: 40rpx;
}

.hero-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(248, 242, 233, 0.16);
  border: 2rpx solid rgba(248, 242, 233, 0.2);
  font-size: 22rpx;
}

.panel {
  margin-top: 22rpx;
}

.provider-list {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
}

.provider-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8f1e6;
  border: 2rpx solid transparent;
}

.provider-card-active {
  background: rgba(47, 107, 95, 0.12);
  border-color: #2f6b5f;
  box-shadow: 0 10rpx 24rpx rgba(47, 107, 95, 0.12);
}

.provider-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #16302b;
}

.provider-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7e7367;
}

.status-row {
  margin-top: 18rpx;
}

.status-label {
  display: block;
  font-size: 22rpx;
  color: #8a7e72;
}

.status-value {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #16302b;
  word-break: break-all;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.status-metric {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8f1e6;
}

.status-metric-label {
  display: block;
  font-size: 22rpx;
  color: #8a7e72;
}

.status-metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #16302b;
}

.field-input {
  margin-top: 18rpx;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #f8f1e6;
  box-sizing: border-box;
  font-size: 24rpx;
}

.warning-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9b4132;
}

.inline-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.inline-actions-top {
  margin-top: 14rpx;
  margin-bottom: 4rpx;
}

.minor-action {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #efe6d7;
  color: #8a5f24;
  font-size: 22rpx;
}

.minor-action-danger {
  color: #9b4132;
  background: rgba(211, 93, 71, 0.12);
}

.save-btn {
  margin-top: 24rpx;
  height: 90rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #21493f 0%, #2f6b5f 100%);
  color: #f8f2e9;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
