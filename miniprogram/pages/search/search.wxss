page {
  background: #f3ede3;
  color: #16302b;
}

.page-shell {
  padding: 112px 24rpx 40rpx;
}

.hero-card,
.panel,
.result-panel {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(125, 92, 38, 0.08);
}

.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(23, 52, 45, 0.96) 0%, rgba(47, 107, 95, 0.94) 72%, rgba(199, 140, 59, 0.88) 100%);
  color: #f8f2e9;
}

.hero-dot {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-dot-a {
  width: 120rpx;
  height: 120rpx;
  top: -40rpx;
  right: -24rpx;
}

.hero-dot-b {
  width: 68rpx;
  height: 68rpx;
  bottom: 36rpx;
  right: 120rpx;
}

.hero-title {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 700;
}

.hero-subtitle {
  margin: 12rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.88;
}

.panel,
.result-panel {
  margin-top: 22rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.section-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a6f63;
}

.recent-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.recent-chip,
.filter-chip,
.soft-chip,
.subfilter-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #5f564d;
}

.recent-chip,
.filter-chip {
  background: #efe5d6;
}

.soft-chip,
.subfilter-chip {
  background: #f7f1e7;
  border: 2rpx solid rgba(22, 48, 43, 0.08);
}

.filter-chip.active,
.soft-chip.active,
.subfilter-chip.active {
  background: #16302b;
  border-color: #16302b;
  color: #f8f2e9;
}

.chip-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.time-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.empty-panel {
  padding: 80rpx 20rpx;
  text-align: center;
}

.state-illustration {
  width: 360rpx;
  height: 248rpx;
  margin: 0 auto 14rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #81766a;
}

.result-list {
  margin-top: 18rpx;
}

.result-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffdf9;
}

.result-card:active {
  transform: scale(0.99);
  background: #fff9f1;
}

.result-card + .result-card {
  margin-top: 14rpx;
}

.result-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.result-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(47, 107, 95, 0.14) 0%, rgba(199, 140, 59, 0.14) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.result-copy {
  flex: 1;
  min-width: 0;
}

.result-title {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #16302b;
}

.result-preview {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #776d62;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-time {
  font-size: 21rpx;
  color: #9d9387;
  flex-shrink: 0;
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  margin-left: 94rpx;
}

.meta-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(22, 48, 43, 0.08);
  background: #faf4ea;
  color: #6a6056;
  font-size: 21rpx;
}

.meta-pill-primary {
  background: rgba(47, 107, 95, 0.12);
  border-color: transparent;
  color: #235346;
}
