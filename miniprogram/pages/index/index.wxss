page {
  background: #f3ede3;
  color: #16302b;
}

.page-shell {
  padding: 112px 24rpx 220rpx;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 8rpx;
}

.nav-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(22, 48, 43, 0.08);
  color: #16302b;
  font-size: 24rpx;
}

.nav-chip-gear {
  background: #16302b;
  color: #f8f2e9;
  box-shadow: 0 10rpx 20rpx rgba(22, 48, 43, 0.2);
}

.nav-chip-icon {
  width: 24rpx;
  height: 24rpx;
}

.nav-chip-icon-light {
  filter: brightness(1.2);
}

.nav-chip-dark {
  background: #16302b;
  color: #f8f2e9;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #17342d 0%, #2f6b5f 62%, #c78c3b 100%);
  color: #f8f2e9;
  box-shadow: 0 24rpx 48rpx rgba(22, 48, 43, 0.16);
}

.hero-orb {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-orb-a {
  width: 160rpx;
  height: 160rpx;
  top: -52rpx;
  right: -36rpx;
}

.hero-orb-b {
  width: 86rpx;
  height: 86rpx;
  bottom: 28rpx;
  right: 138rpx;
  background: rgba(255, 248, 238, 0.14);
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.78;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.88;
}

.home-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 251, 245, 0.14);
  border: 2rpx solid rgba(248, 242, 233, 0.18);
}

.home-search-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(1.3);
  flex-shrink: 0;
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  color: #f8f2e9;
  font-size: 24rpx;
}

.home-search-action {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 242, 233, 0.18);
  color: #f8f2e9;
  font-size: 22rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 30rpx;
}

.feature-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(248, 242, 233, 0.14);
  backdrop-filter: blur(14rpx);
}

.feature-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}

.feature-value {
  margin-top: 8rpx;
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.panel,
.message-section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(125, 92, 38, 0.08);
}

.insight-panel {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-end;
}

.panel-title,
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.panel-subtitle,
.section-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a6f63;
  line-height: 1.6;
}

.trend-row {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.trend-bar {
  width: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #c78c3b 0%, #2f6b5f 100%);
}

.trend-day {
  font-size: 18rpx;
  color: #8a8176;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.section-action,
.message-count {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #efe6d7;
  color: #8a5f24;
  font-size: 22rpx;
}

.chip-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.chip-scroll-tight {
  margin-top: 14rpx;
}

.chip-row {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.filter-chip,
.soft-chip,
.subfilter-chip {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5a524b;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.filter-chip {
  background: #f0e7da;
}

.soft-chip,
.subfilter-chip {
  background: #f7f1e7;
  border: 2rpx solid rgba(22, 48, 43, 0.08);
}

.filter-chip.active,
.soft-chip.active,
.subfilter-chip.active {
  background: #16302b;
  color: #f8f2e9;
  border-color: #16302b;
  box-shadow: 0 10rpx 22rpx rgba(22, 48, 43, 0.18);
  transform: translateY(-2rpx);
}

.subfilter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.project-summary {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(90deg, rgba(47, 107, 95, 0.12) 0%, rgba(199, 140, 59, 0.14) 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.project-summary-label {
  font-size: 22rpx;
  color: #6e655b;
}

.project-summary-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #16302b;
}

.loading-wrap,
.empty-panel {
  padding: 84rpx 24rpx;
  text-align: center;
}

.skeleton-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  text-align: left;
}

.skeleton-badge,
.skeleton-title,
.skeleton-line {
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(230, 221, 204, 0.6) 25%, rgba(244, 238, 230, 0.95) 50%, rgba(230, 221, 204, 0.6) 75%);
  background-size: 200% 100%;
}

.skeleton-badge {
  width: 120rpx;
  height: 22rpx;
}

.skeleton-title {
  width: 78%;
  height: 30rpx;
  margin-top: 18rpx;
}

.skeleton-line {
  width: 100%;
  height: 18rpx;
  margin-top: 16rpx;
}

.skeleton-line-short {
  width: 62%;
}

.shimmer {
  animation: shimmer 1.5s linear infinite;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #81766a;
}

.empty-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9a8d80;
}

.state-illustration {
  width: 360rpx;
  height: 248rpx;
  margin: 0 auto 14rpx;
}

.message-list {
  margin-top: 20rpx;
}

.message-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  box-shadow: 0 12rpx 26rpx rgba(58, 41, 10, 0.06);
}

.message-card:active {
  transform: scale(0.99);
  background: #fff9f1;
}

.message-card + .message-card {
  margin-top: 16rpx;
}

.message-layout {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.message-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(47, 107, 95, 0.14) 0%, rgba(199, 140, 59, 0.14) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.message-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.message-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.message-copy {
  flex: 1;
  min-width: 0;
}

.message-summary {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #16302b;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.message-time {
  padding-top: 4rpx;
  font-size: 21rpx;
  color: #9d9387;
  flex-shrink: 0;
}

.message-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.meta-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(22, 48, 43, 0.08);
  background: #faf4ea;
  color: #6a6056;
  font-size: 21rpx;
}

.meta-pill-primary {
  background: rgba(47, 107, 95, 0.12);
  border-color: transparent;
  color: #235346;
}

.loading-more {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7b7065;
}

.loading-more.muted {
  color: #9f968b;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 18rpx calc(env(safe-area-inset-bottom, 16rpx) + 12rpx);
  background: rgba(248, 242, 233, 0.96);
  backdrop-filter: blur(18rpx);
  border-top: 1px solid rgba(22, 48, 43, 0.06);
  z-index: 40;
}

.bottom-bar.attach-open {
  background: rgba(245, 238, 227, 0.98);
}

.input-shell {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.attach-plus {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #efe6d7;
  color: #6d614f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(116, 95, 63, 0.14);
}

.text-input {
  flex: 1;
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #fffdf9;
  font-size: 25rpx;
  box-sizing: border-box;
}

.text-input-wechat {
  border-radius: 36rpx;
  background: #ffffff;
  border: 2rpx solid rgba(22, 48, 43, 0.05);
}

.send-btn {
  min-width: 118rpx;
  padding: 0 24rpx;
  background: #e7ddd0;
  color: #fff;
}

.send-btn.active {
  background: linear-gradient(135deg, #ff9d2e 0%, #e6631f 100%);
  box-shadow: 0 12rpx 24rpx rgba(230, 99, 31, 0.28);
}

.send-btn-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.attach-row {
  display: none;
  gap: 14rpx;
  margin-top: 16rpx;
}

.attach-row.show {
  display: flex;
}

.attach-card {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: #fffdf9;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 22rpx rgba(58, 41, 10, 0.05);
}

.attach-card:active {
  transform: scale(0.98);
}

.attach-icon {
  width: 44rpx;
  height: 44rpx;
}

.attach-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6e655b;
}

.sheet-panel {
  padding: 24rpx 24rpx 36rpx;
  background: #fffaf2;
  border-radius: 36rpx 36rpx 0 0;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.sheet-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7b7065;
}

.sheet-close {
  font-size: 32rpx;
  color: #8d8378;
}

.sheet-list {
  margin-top: 22rpx;
}

.sheet-group + .sheet-group {
  margin-top: 18rpx;
}

.sheet-group-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding: 0 6rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #6e655b;
}

.sheet-group-title-recent {
  color: #2f6b5f;
}

.sheet-group-title-pinned {
  color: #8a5f24;
}

.sheet-group-icon {
  width: 28rpx;
  height: 28rpx;
}

.sheet-group-count {
  min-width: 32rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(110, 101, 91, 0.1);
  color: inherit;
  font-size: 18rpx;
  text-align: center;
}

.sheet-search-input {
  margin-top: 18rpx;
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f8f1e6;
  box-sizing: border-box;
  font-size: 24rpx;
}

.sheet-item {
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #16302b;
  border: 2rpx solid transparent;
}

.sheet-item + .sheet-item {
  margin-top: 12rpx;
}

.sheet-item.active {
  background: rgba(47, 107, 95, 0.12);
  border-color: rgba(47, 107, 95, 0.28);
  color: #235346;
}

.sheet-item-recent {
  background: linear-gradient(90deg, rgba(47, 107, 95, 0.08) 0%, #fff 34%);
}

.sheet-item-pinned {
  background: linear-gradient(90deg, rgba(199, 140, 59, 0.14) 0%, #fffaf2 48%, #fff 100%);
  border-color: rgba(199, 140, 59, 0.16);
  box-shadow: 0 10rpx 24rpx rgba(138, 95, 36, 0.08);
}

.sheet-item-accent {
  width: 8rpx;
  height: 54rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sheet-item-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.sheet-item-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.sheet-item-name {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-item-badge {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(199, 140, 59, 0.18);
  color: #8a5f24;
  font-size: 18rpx;
  font-weight: 600;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.sheet-item-count {
  font-size: 22rpx;
  color: #908477;
}

.sheet-item-meta {
  font-size: 22rpx;
  color: #908477;
}

.sheet-pin {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #efe6d7;
  color: #8a5f24;
  font-size: 20rpx;
}

.sheet-pin.active {
  background: rgba(199, 140, 59, 0.2);
  color: #8a5f24;
}

.sheet-empty {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a7e72;
}

.sheet-create {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #16302b;
  color: #f8f2e9;
  text-align: center;
  font-size: 24rpx;
}

.dialog-body {
  padding: 8rpx 10rpx 18rpx;
}

.dialog-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #16302b;
}

.dialog-input {
  margin-top: 18rpx;
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f8f1e6;
  box-sizing: border-box;
  font-size: 24rpx;
}

.dialog-panel {
  padding: 28rpx 24rpx 34rpx;
  background: #fffaf2;
  border-radius: 36rpx 36rpx 0 0;
}

.dialog-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.dialog-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 22rpx;
  background: #16302b;
  color: #f8f2e9;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-btn-muted {
  background: #efe6d7;
  color: #16302b;
}
