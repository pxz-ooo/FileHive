page {
  background: #f3ede3;
  color: #16302b;
}

.page-shell {
  padding: 112px 24rpx 48rpx;
}

.nav-back {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding-left: 8rpx;
}

.nav-back-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-back-text {
  font-size: 26rpx;
  color: #16302b;
}

.hero-card,
.panel {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(125, 92, 38, 0.08);
}

.hero-card {
  background: linear-gradient(135deg, rgba(23, 52, 45, 0.96) 0%, rgba(47, 107, 95, 0.94) 72%, rgba(199, 140, 59, 0.88) 100%);
  color: #f8f2e9;
}

.hero-title,
.panel-title,
.platform-name {
  font-size: 30rpx;
  font-weight: 700;
}

.hero-title {
  font-size: 40rpx;
}

.hero-subtitle,
.note-text,
.platform-value,
.platform-parser {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.panel {
  margin-top: 22rpx;
}

.platform-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.platform-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8f1e6;
}

.platform-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.platform-parser {
  margin-top: 0;
  color: #8a5f24;
}

.platform-row {
  margin-top: 16rpx;
}

.platform-label {
  display: block;
  font-size: 22rpx;
  color: #8a7e72;
}

.platform-value,
.note-text {
  margin-top: 8rpx;
  color: #16302b;
}
