page {
  background: #f3ede3;
  color: #16302b;
}

.page-shell {
  padding: 112px 24rpx 44rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #17342d 0%, #2f6b5f 64%, #c78c3b 100%);
  color: #f8f2e9;
  box-shadow: 0 24rpx 48rpx rgba(22, 48, 43, 0.16);
}

.hero-orb {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-orb-a {
  width: 148rpx;
  height: 148rpx;
  top: -36rpx;
  right: -24rpx;
}

.hero-orb-b {
  width: 88rpx;
  height: 88rpx;
  bottom: 26rpx;
  right: 122rpx;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.78;
}

.hero-status {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-status-pending {
  background: rgba(255, 255, 255, 0.14);
}

.hero-status-warning {
  background: rgba(245, 196, 106, 0.22);
}

.hero-status-ready {
  background: rgba(255, 255, 255, 0.2);
}

.hero-type {
  align-self: flex-start;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 242, 233, 0.12);
  border: 2rpx solid rgba(248, 242, 233, 0.3);
  font-size: 22rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 700;
}

.hero-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(248, 242, 233, 0.88);
}

.hero-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(248, 242, 233, 0.45);
  background: rgba(248, 242, 233, 0.08);
  color: #f8f2e9;
  font-size: 22rpx;
}

.hero-pill-primary {
  background: rgba(248, 242, 233, 0.18);
  border-color: transparent;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.97);
  box-shadow: 0 18rpx 40rpx rgba(125, 92, 38, 0.08);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.section-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a6f63;
}

.section-action {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #efe6d7;
  color: #8a5f24;
  font-size: 22rpx;
}

.snapshot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.snapshot-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fffdf9;
}

.snapshot-label {
  font-size: 22rpx;
  color: #8a7e72;
}

.snapshot-value {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #16302b;
}

.snapshot-helper {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #766b60;
}

.platform-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #fffdf9 100%);
  border: 2rpx solid rgba(199, 140, 59, 0.18);
}

.platform-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.platform-mode {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8a5f24;
}

.platform-status {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #72685d;
}

.content-list {
  margin-top: 20rpx;
}

.content-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fffdf9;
}

.content-card + .content-card {
  margin-top: 14rpx;
}

.content-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.content-label {
  font-size: 22rpx;
  color: #8a7e72;
}

.content-copy {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 95, 0.1);
  color: #235346;
  font-size: 20rpx;
}

.content-value {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #16302b;
  white-space: pre-wrap;
  word-break: break-word;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.meta-card {
  min-height: 136rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  box-sizing: border-box;
}

.meta-card-action:active {
  background: #fff7ed;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: #8a7e72;
}

.meta-value {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #16302b;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 95, 0.12);
  color: #235346;
  font-size: 22rpx;
}

.hint-list {
  margin-top: 18rpx;
}

.hint-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
}

.hint-item + .hint-item {
  border-top: 2rpx solid rgba(138, 95, 36, 0.08);
}

.hint-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #c78c3b;
  flex-shrink: 0;
}

.hint-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #16302b;
}

.raw-block {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  font-size: 21rpx;
  line-height: 1.7;
  color: #5f564d;
  white-space: pre-wrap;
  word-break: break-word;
}

.action-spacer {
  height: 190rpx;
}

.sticky-action-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom, 0) + 16rpx);
  z-index: 20;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 250, 242, 0.96);
  box-shadow: 0 -2rpx 24rpx rgba(22, 48, 43, 0.08), 0 18rpx 44rpx rgba(22, 48, 43, 0.12);
  backdrop-filter: blur(16rpx);
}

.sticky-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #21493f 0%, #2f6b5f 100%);
  color: #f8f2e9;
  font-size: 28rpx;
  font-weight: 700;
}

.sticky-secondary-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.sticky-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 18rpx;
  background: #efe6d7;
  color: #16302b;
  font-size: 24rpx;
}

.sticky-chip-danger {
  background: rgba(211, 93, 71, 0.12);
  color: #9b4132;
}

.loading-wrap,
.error-wrap {
  padding: 180rpx 24rpx 0;
  text-align: center;
}

.state-illustration {
  width: 360rpx;
  height: 248rpx;
  margin: 0 auto 16rpx;
}

.state-illustration-loading {
  opacity: 0.82;
}

.error-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.error-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #81766a;
}

.sheet-panel {
  padding: 24rpx 24rpx 36rpx;
  background: #fffaf2;
  border-radius: 36rpx 36rpx 0 0;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16302b;
}

.sheet-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7b7065;
}

.sheet-close {
  font-size: 34rpx;
  color: #8d8378;
}

.sheet-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #16302b;
}

.sheet-item + .sheet-item {
  margin-top: 12rpx;
}

.sheet-item:first-of-type {
  margin-top: 22rpx;
}

.sheet-item.active {
  background: rgba(47, 107, 95, 0.12);
  color: #235346;
}

.sheet-item-count {
  font-size: 22rpx;
  color: #908477;
}

.dialog-body {
  padding: 8rpx 10rpx 18rpx;
}

.dialog-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #16302b;
}

.dialog-textarea {
  width: 100%;
  min-height: 200rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8f1e6;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.7;
}
